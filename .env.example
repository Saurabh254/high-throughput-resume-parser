# PostgreSQL & pgvector Configuration
POSTGRES_DB=ats_parser_db
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ats_user:ats_password@localhost:5432/ats_parser_db

# Redis Configuration (Multi-Tier Caching & Ingestion Queue)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Ingestion Service Configuration (Port 8001)
INGESTION_SERVICE_PORT=8001
INGESTION_SERVICE_URL=http://localhost:8001

# LLM Experience Parsing Engine
# Options: 'heuristic' (fast zero-RAM deterministic), 'ollama' (local), 'openai' (cloud API)
LLM_PROVIDER=heuristic
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Orchestration & Ranking Service Configuration (Port 8002)
ORCHESTRATOR_SERVICE_PORT=8002
ORCHESTRATOR_SERVICE_URL=http://localhost:8002
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
RERANKER_MODEL_NAME=Xenova/ms-marco-MiniLM-L-6-v2

# Next.js Frontend Gateway Configuration (Port 3000)
FRONTEND_PORT=3000
